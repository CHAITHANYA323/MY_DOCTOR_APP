# =============================================================================
# MEDICONNECT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# IMPORTANT: This file is a template containing placeholders only.
# NEVER commit real credentials, API keys, tokens, or database passwords to Git!
# Copy this file to '.env' in your deployment environment and populate actual values.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Application Environment
# -----------------------------------------------------------------------------
FLASK_ENV=development
FLASK_PORT=5000

# High-entropy random secret key for session signing and JWT generation (64+ characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_HERE_MIN_32_CHARS
JWT_EXPIRATION_HOURS=72

# -----------------------------------------------------------------------------
# 2. Database Connection Options
# -----------------------------------------------------------------------------
# In local development: leave DATABASE_URL unset to automatically use local SQLite ('doctor_hospital.db').
# In production (FLASK_ENV=production): a remote PostgreSQL or MySQL DATABASE_URL is strictly required.

# --- NEON POSTGRESQL CONFIGURATION ---
#
# RUNTIME CONNECTION (Neon Pooled Endpoint):
# Used by the Flask API server for request handling.
# Uses Neon's built-in PgBouncer transaction pooler (hostname contains '-pooler').
# Format: postgresql+psycopg2://<user>:<password>@ep-<project-id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://<user>:YOUR_NEON_PASSWORD@ep-<project>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# MIGRATION & DDL CONNECTION (Neon Direct Compute Endpoint):
# Used exclusively by 'python backend/manage.py migrate' and schema DDL operations.
# Connects directly to Neon compute without PgBouncer (hostname does NOT contain '-pooler').
# Format: postgresql+psycopg2://<user>:<password>@ep-<project-id>.<region>.aws.neon.tech/<dbname>?sslmode=require
MIGRATION_DATABASE_URL=postgresql://<user>:YOUR_NEON_PASSWORD@ep-<project>.<region>.aws.neon.tech/<dbname>?sslmode=require

# --- DATABASE CONNECTION POOL TUNING ---
# Pre-ping tests connections before checkout to prevent stale connection errors from Neon auto-suspension.
# Recycle closes connections after 300 seconds to prevent load balancer timeouts.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

# -----------------------------------------------------------------------------
# 3. Distributed Redis Rate Limiting (SEC-06)
# -----------------------------------------------------------------------------
# In production (FLASK_ENV=production), REDIS_URL is mandatory for distributed rate limiting.
# Upstash / Managed Redis with TLS (rediss:// protocol is strictly recommended for cloud):
# Format: rediss://default:<password>@<host>:<port>
# Example Local Dev: redis://localhost:6379/0
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@sample-redis.upstash.io:6379

RATE_LIMIT_STORAGE=auto
RATE_LIMIT_FAIL_CLOSED=true

# -----------------------------------------------------------------------------
# 4. Ingress Reverse Proxy & ProxyFix Configuration (BLK-04)
# -----------------------------------------------------------------------------
# Set to 'true' when deployed behind Cloudflare, Nginx, Render, or Vercel reverse proxies.
# When enabled, Werkzeug's ProxyFix safely unwraps X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY_HEADERS=false

# Trusted reverse proxy IPs or CIDR blocks permitted to supply client IP headers:
TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8

# ProxyFix trusted hop counts (1 for Render / single proxy; 2 if behind Cloudflare + Render):
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=0
PROXY_FIX_X_PREFIX=0

# -----------------------------------------------------------------------------
# 5. CORS Allowed Origins (BLK-05)
# -----------------------------------------------------------------------------
# Comma-separated list of approved web origins allowed to access the backend API.
# In production, wildcard origins are rejected. Blind origin reflection is blocked.
# In local development, localhost and 127.0.0.1 are automatically permitted.
ALLOWED_ORIGINS=https://mediconnect.health,https://admin.mediconnect.health
