# Backend Environment Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=super-secret-jwt-and-session-key-medicare-2026

# MySQL Database Configuration
# If MySQL connection fails or credentials are not yet set, the server seamlessly falls back to SQLite (doctor_hospital.db)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=doctor_hospital_db

# Or direct DATABASE_URL (takes precedence if provided - PostgreSQL or MySQL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/doctor_hospital_db

# CORS Allowed Origins (comma-separated for custom domains; *.vercel.app is allowed by default)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com
