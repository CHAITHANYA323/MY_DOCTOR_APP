# =============================================================================
# MEDICONNECT PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# File: backend/.env.production.example
# Target Deployment File: backend/.env (or injected via secure secret store)
#
# IMPORTANT SECURITY DIRECTIVES:
# 1. NEVER commit production secrets, passwords, or private keys to version control.
# 2. In production (FLASK_ENV=production), Config.validate_production_config()
#    strictly enforces that:
#    - SECRET_KEY is not default and has sufficient entropy.
#    - SQLite is strictly forbidden.
#    - Persistent MySQL 8+ or PostgreSQL database is configured.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Production Settings
# -----------------------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_PORT=5000

# High-entropy production SECRET_KEY (minimum 64 characters recommended).
# Generate a cryptographically secure key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_MIN_64_CHARS

# JWT authentication token lifetime in hours (e.g., 24 or 72)
JWT_EXPIRATION_HOURS=72

# -----------------------------------------------------------------------------
# 2. Production Database Configuration (MySQL 8+ Recommended)
# -----------------------------------------------------------------------------
# For standard MySQL 8 installations (Local Dedicated Server, AWS RDS, Cloud SQL):
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mediconnect_app
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD
MYSQL_DB=mediconnect

# Alternative: Unified connection URI (takes precedence over discrete variables)
# DATABASE_URL=mysql+pymysql://mediconnect_app:REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD@127.0.0.1:3306/mediconnect?charset=utf8mb4

# Database Connection Pool Tuning for Production
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

# -----------------------------------------------------------------------------
# 3. Distributed Redis Rate Limiting (OWASP / Brute-Force Defense)
# -----------------------------------------------------------------------------
# Managed Redis with TLS (e.g. Upstash, AWS ElastiCache, Redis Enterprise)
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@sample-redis.production.cache:6379

RATE_LIMIT_STORAGE=auto
RATE_LIMIT_FAIL_CLOSED=true

# -----------------------------------------------------------------------------
# 4. Ingress Reverse Proxy & ProxyFix Hardening (Cloudflare / Nginx / ALB)
# -----------------------------------------------------------------------------
# Must be set to 'true' when deployed behind an HTTPS reverse proxy (Nginx, Traefik, Cloudflare).
# ProxyFix safely extracts client IP and protocol without spoofing.
TRUST_PROXY_HEADERS=true

# Comma-separated trusted upstream proxy IPs or CIDR blocks:
TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8

# ProxyFix hop counts:
# 1 = Single reverse proxy (e.g., Nginx on same server or single ALB)
# 2 = Double proxy (e.g., Cloudflare CDN in front of Nginx/ALB)
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=0
PROXY_FIX_X_PREFIX=0

# -----------------------------------------------------------------------------
# 5. CORS Hardened Production Origins
# -----------------------------------------------------------------------------
# Explicitly whitelist approved web client domains (No wildcards permitted).
# Comma-separated list:
ALLOWED_ORIGINS=https://mediconnect.yourdomain.com,https://admin.mediconnect.yourdomain.com
